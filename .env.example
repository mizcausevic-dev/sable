# Copy to .env.local. Leave DATABASE_URL empty to use embedded Postgres in DATA_DIR.

# Postgres connection. When unset, Sable uses PGlite under DATA_DIR and applies supabase/migrations on boot.
DATABASE_URL=

# Directory for the embedded database and locally stored uploads.
DATA_DIR=.data/pglite

# Required in production. At least 32 characters. Development uses a fixed local secret when this is unset.
SESSION_SECRET=

# Set to 1 to load the fictional seed when the users table is empty. Development does this unless NODE_ENV=production.
SEED_ON_BOOT=

# Optional Supabase Auth. Both values are required before sign-in is delegated to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Enables the private sable-private storage bucket. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# When unset, provider-confirmed payments stay unavailable and billing is the mock adapter.
# Setting a name does not charge a card. It only allows a provider-confirmed ledger row with a reference.
PAYMENT_PROVIDER=

# Set to 1 to show seeded demo accounts on the sign-in page in production.
SHOW_DEMO_ACCOUNTS=
